# NABH Compliance Engine — Backend Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────
# PostgreSQL (recommended for production — Supabase session pooler URI)
# Example: postgres://postgres.xxx:password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=your_postgresql_uri_here

# SQLite fallback path (used when DATABASE_URL is not set)
DB_PATH=./nabh.db

# Set to "true" ONLY if you must disable SSL verification (not recommended)
DB_SSL_NO_VERIFY=false

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_very_secure_random_string_here

# Required for the /api/system/factory-reset endpoint
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
SYSTEM_RESET_KEY=another_secure_string_for_factory_reset

# ── Initial Admin Account ─────────────────────────────────────
# Only used when SEED_DB=true — set to a strong password and change after first login
INITIAL_ADMIN_PASSWORD=ChangeMe@2026!

# Set to "true" ONCE to create the initial admin user, then set back to "false"
SEED_DB=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Server ───────────────────────────────────────────────────
PORT=8000

# ── Render Detection ─────────────────────────────────────────
# Set automatically by Render. Do NOT set this manually.
# RENDER=true
